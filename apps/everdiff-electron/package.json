{
  "name": "@everdiff/electron",
  "version": "0.0.0",
  "private": true,
  "description": "Everdiff desktop application",
  "license": "UNLICENSED",
  "author": "Everdiff",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "bun run --bun electron-forge start",

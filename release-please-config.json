{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "9c2f3bdc1a5d68b7559c89a8ec8a3a787fb7fa9e",
  "always-update": true,
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "pull-request-header": "Prepare the next Everdiff release.",
      "pull-request-footer": "Generated by Release Please.",
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "perf", "section": "Improved" },
        { "type": "fix", "section": "Fixed" },
        { "type": "revert", "section": "Reverted" },
        { "type": "chore", "section": "Internal", "hidden": true },
        { "type": "ci", "section": "Internal", "hidden": true },
        { "type": "build", "section": "Internal", "hidden": true },
        { "type": "docs", "section": "Internal", "hidden": true },
        { "type": "refactor", "section": "Internal", "hidden": true },
        { "type": "style", "section": "Internal", "hidden": true },
        { "type": "test", "section": "Internal", "hidden": true }
      ],
      "extra-files": [
        { "type": "json", "path": "apps/everdiff-electron/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/everdiff-web/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
